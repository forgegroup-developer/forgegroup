# ── Resend — email form contatti + newsletter → info@forgegroup.it ──
#
# Setup (una tantum):
# 1. Account su https://resend.com
# 2. Aggiungi e verifica il dominio forgegroup.it su Resend (DNS su OVH Zona DNS)
#    Record richiesti (nameserver OVH: dns200.anycast.me / ns200.anycast.me):
#    - TXT  resend._domainkey  → chiave DKIM da Resend
#    - MX   send               → feedback-smtp.eu-west-1.amazonses.com (prio 10)
#    - TXT  send               → v=spf1 include:amazonses.com ~all
#    Gmail resta su @: MX smtp.google.com + TXT google._domainkey (non toccare)
# 3. Resend → Domains → forgegroup.it → Verify DNS Records
# 4. Su Vercel: Project → Settings → Environment Variables
#    Aggiungi le 3 variabili sotto per Production (e Preview se serve testare)
# 5. Redeploy del sito dopo aver salvato le variabili
#
# Flussi già collegati nel codice:
# - Form /contatti     → POST /api/contact     → email interna a RESEND_TO (default info@forgegroup.it)
# - Form /visione      → POST /api/candidatura → email interna a RESEND_TO (default info@forgegroup.it)
# - Footer newsletter  → POST /api/newsletter  → email a RESEND_TO
# - replyTo = email del visitatore (puoi rispondere direttamente)

RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Forge Group <info@forgegroup.it>
RESEND_TO=info@forgegroup.it

# ── Google Analytics 4 — tracking automatico su tutte le pagine ──
#
# Setup (una tantum):
# 1. https://analytics.google.com → crea property GA4 (se non esiste)
# 2. Admin → Flussi di dati → Web → crea/apri flusso per forgegroup.it
# 3. Copia il "ID misurazione" (formato G-XXXXXXXXXX)
# 4. Su Vercel: Project → Settings → Environment Variables
#    Aggiungi NEXT_PUBLIC_GA_MEASUREMENT_ID per Production (e Preview)
# 5. Redeploy del sito dopo aver salvato la variabile
#
# Il tag GA4 (via @next/third-parties) è già nel root layout: si carica su
# ogni pagina e traccia le pageview automaticamente, incluse le nuove pagine
# aggiunte in futuro — nessuna azione richiesta ad ogni modifica del sito.

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── ForgeFlow — blog da database Neon condiviso ──
#
# Stesso DATABASE_URL usato in ForgeFlow (.env.local)
# REVALIDATE_SECRET = stesso valore di SITE_REVALIDATE_SECRET in ForgeFlow
#
# Su Vercel (progetto forgegroup) → Settings → Environment Variables → Production:
#   DATABASE_URL=postgresql://...
#   REVALIDATE_SECRET=stringa-lunga-casuale
#
# Dopo il salvataggio: redeploy del sito.

DATABASE_URL=postgresql://...
REVALIDATE_SECRET=stringa-lunga-casuale
