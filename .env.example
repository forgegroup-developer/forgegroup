# ── Resend — email form contatti + newsletter → info@forgegroup.it ──
#
# Setup (una tantum):
# 1. Account su https://resend.com
# 2. Aggiungi e verifica il dominio forgegroup.it (DNS: SPF, DKIM da Resend)
# 3. API Keys → crea chiave → incollala in RESEND_API_KEY
# 4. Su Vercel: Project → Settings → Environment Variables
#    Aggiungi le 3 variabili sotto per Production (e Preview se serve testare)
# 5. Redeploy del sito dopo aver salvato le variabili
#
# Flussi già collegati nel codice:
# - Form /contatti  → POST /api/contact  → email a RESEND_TO
# - Footer newsletter → POST /api/newsletter → email a RESEND_TO
# - replyTo = email del visitatore (puoi rispondere direttamente)

RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Forge Group <info@forgegroup.it>
RESEND_TO=info@forgegroup.it
